---
import '../styles/global.css';
import {href} from '../lib/site';
interface Props {title:string;description:string;article?:boolean;}
const{title,description,article=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site).href;
const social=new URL(href('social.jpg'),Astro.site).href;
const navigation=[['Leistungen','leistungen/'],['Projekte','projekte/'],['Über uns','ueber-uns/'],['Fachwissen','fachwissen/']];
---
<!doctype html><html lang="de"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | KERNFELD</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={`${title} | KERNFELD`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:locale" content="de_DE"/><meta property="og:image" content={social}/><meta name="twitter:card" content="summary_large_image"/><meta name="theme-color" content="#142d42"/><link rel="icon" href={href('favicon.svg')}/><link rel="preload" href={href('fonts/sans.woff2')} as="font" type="font/woff2" crossorigin/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Organization',name:'KERNFELD (fiktive Portfolio-Demo)',url:new URL(href(),Astro.site).href,description:'Portfolio-Demoprojekt – Unternehmen und Geschäftsdaten sind fiktiv.'})}/></head><body><a class="skip" href="#inhalt">Zum Inhalt</a><div class="topline"><div>TECHNIK VERSTEHEN. ENTSCHEIDUNGEN VORBEREITEN.</div><span>Rhein-Neckar & darüber hinaus</span></div><header class="header"><a class="logo" href={href()} aria-label="KERNFELD Startseite"><svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true"><path fill="currentColor" d="M0 0h9v14L23 0h9L17 16l15 16h-9L9 18v14H0Z"/></svg>KERNFELD<span>ENERGIE & TECHNIK</span></a><button class="menu-toggle" aria-label="Menü öffnen" aria-expanded="false" aria-controls="navigation">Menü <span aria-hidden="true">☰</span></button><nav id="navigation" aria-label="Hauptnavigation">{navigation.map(([label,path])=><a href={href(path)} aria-current={Astro.url.pathname.endsWith(path)?'page':undefined}>{label}</a>)}<a class="button small" href={href('kontakt/')}>Projekt besprechen <span aria-hidden="true">↗</span></a></nav></header><main id="inhalt"><slot/></main><footer><div class="footer-top"><a class="logo" href={href()}>KERNFELD</a><p>Klare Analysen.<br>Tragfähige Entscheidungen.</p><div><a href={href('leistungen/')}>Unsere Leistungen</a><a href={href('kontakt/')}>Kontakt aufnehmen</a><a href={href('fachwissen/')}>Fachwissen lesen</a></div></div><div class="footer-bottom"><p>Portfolio-Demoprojekt – Unternehmen und Geschäftsdaten sind fiktiv.</p><div><a href={href('impressum/')}>Impressum-Demo</a><a href={href('datenschutz/')}>Datenschutz-Demo</a></div><span>© 2026 KERNFELD</span></div></footer><script>import '../scripts/site';</script></body></html>
