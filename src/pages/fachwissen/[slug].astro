---
import Layout from '../../layouts/Layout.astro';import {articles} from '../../data/content';import {href} from '../../lib/site';
export function getStaticPaths(){return articles.map(article=>({params:{slug:article.slug},props:{article}}));}const{article}=Astro.props;
---
<Layout title={article.title} description={article.teaser} article><article class="article-body"><a class="breadcrumb" href={href('fachwissen/')}>← Alle Fachbeiträge</a><p class="eyebrow">{article.category} · {article.read}</p><h1>{article.title}</h1><p class="article-lead">{article.teaser}</p><p class="article-date">Redaktion KERNFELD · <time datetime={article.date}>{new Date(article.date).toLocaleDateString('de-DE',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time> · Demo-Fachbeitrag</p>{article.sections.map(([title,text])=><section><h2>{title}</h2><p>{text}</p></section>)}<aside class="notice">Allgemeine technische Orientierung innerhalb eines Portfolio-Demoprojekts. Keine projektbezogene Planung oder fachliche Prüfung eines konkreten Betriebs.</aside><a class="button" href={href('leistungen/')}>Passende Leistungen ansehen ↗</a></article><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Article',headline:article.title,datePublished:article.date,description:article.teaser,inLanguage:'de-DE',author:{'@type':'Organization',name:'Redaktion KERNFELD (Portfolio-Demo)'}})}/></Layout>
