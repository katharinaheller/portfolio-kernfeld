---
import Layout from '../../layouts/Layout.astro';import Cta from '../../components/Cta.astro';import {services} from '../../data/content';import {href} from '../../lib/site';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}));}
const{service}=Astro.props;
---
<Layout title={`${service.title} für den Mittelstand`} description={service.description}><section class="page-intro"><a class="breadcrumb" href={href('leistungen/')}>Startseite / Leistungen /</a><p class="eyebrow">LEISTUNG {service.number}</p><h1>{service.short}</h1><p>{service.description}</p></section><section class="section detail-grid"><div><p class="eyebrow">WAS SIE ERHALTEN</p><h2>{service.title}<br>mit klarem Ergebnis.</h2><p>{service.result}</p><h3>Für wen ist das sinnvoll?</h3><p>{service.audience}.</p><h3>Wie läuft die Zusammenarbeit?</h3><p>Im Erstgespräch klären wir Fragestellung, Datengrundlage und gewünschte Entscheidungstiefe. Darauf folgt ein abgegrenzter Leistungsumfang. Ergebnisse besprechen wir gemeinsam mit den fachlich Verantwortlichen.</p></div><aside class="scope-box"><p class="eyebrow">LEISTUNGSUMFANG</p><ul>{service.scope.map(item=><li>{item}</li>)}</ul><p><strong>{service.time}</strong><br>Typischer Zeitraum nach vollständigem Dateneingang. Projektabhängig.</p><a class="button" href={href('kontakt/')}>Anfrage vorbereiten ↗</a></aside></section><section class="section faq-section"><h2>Eine häufige Frage.</h2><details open><summary>{service.question}</summary><p>{service.answer}</p></details><p>Alle Leistungsbeschreibungen zeigen ein fiktives Beratungskonzept. Es werden keine realen Beratungsverträge angeboten.</p></section><section class="section"><h2>Passende nächste Schritte</h2><div class="related-links">{services.filter(s=>s.slug!==service.slug).map(s=><a href={href(`leistungen/${s.slug}/`)}>{s.title} ↗</a>)}</div></section><Cta/></Layout>
