---
import Layout from '../layouts/Layout.astro';import Picture from '../components/Picture.astro';import Cta from '../components/Cta.astro';import {services,articles} from '../data/content';import {href} from '../lib/site';
---
<Layout title="Energieberatung, die Ihren Betrieb weiterbringt" description="Energieanalyse, Wärmekonzepte und Transformationsplanung für den Mittelstand im Rhein-Neckar-Raum. Technische Klarheit für Ihre Investitionsentscheidungen. Demo."><section class="hero"><div class="hero-copy"><p class="eyebrow"><span class="blue-square"></span> INGENIEURDENKEN FÜR DEN MITTELSTAND</p><h1>Energie verstehen.<br><span>Richtig entscheiden.</span></h1><p>Ihre Produktion soll laufen. Ihre Energieversorgung soll mitdenken. Wir schaffen die technische Grundlage für wirtschaftlich sinnvolle Veränderungen.</p><a class="button" href={href('leistungen/')}>Unsere Leistungen <span aria-hidden="true">↗</span></a><a class="secondary-link" href={href('kontakt/')}>Erstgespräch vorbereiten →</a></div><div class="hero-image"><Picture alt="Lichtdurchflutete industrielle Fertigungshalle mit Stahltragwerk und Krananlage; generierte Konzeptaufnahme" priority/><div class="image-caption"><span>IM FOKUS</span><p>Der ganze Betrieb.<br>Nicht nur die einzelne Anlage.</p><span aria-hidden="true">↗</span></div></div><div class="hero-index" aria-hidden="true">KF / 01</div></section><section class="trust-strip" aria-label="Unser Arbeitsansatz"><span>TECHNISCH FUNDIERT</span><span>HERSTELLERUNABHÄNGIG KONZIPIERT</span><span>VERSTÄNDLICH DOKUMENTIERT</span></section><section class="section"><div class="section-heading"><div><p class="eyebrow">UNSERE LEISTUNGEN</p><h2>Klarheit schaffen.<br>Handlungsspielraum gewinnen.</h2></div><p>Vom ersten Blick auf Ihre Verbrauchsdaten bis zum abgestimmten Transformationspfad.</p></div><div class="service-grid">{services.map(service=><a class="service-card" href={href(`leistungen/${service.slug}/`)}><div class="service-top"><span>{service.number}</span><span aria-hidden="true">↗</span></div><h3>{service.title}</h3><p>{service.description}</p><span class="card-link">Leistung im Detail →</span></a>)}</div></section><section class="method section"><div><p class="eyebrow">SO ARBEITEN WIR</p><h2>Aus Daten werden<br>Entscheidungen.</h2><p>Ein Bericht allein verändert wenig. Deshalb verbinden wir die Analyse mit den Fragen, die im Betrieb tatsächlich entschieden werden müssen.</p><a class="secondary-link" href={href('ueber-uns/')}>Unsere Arbeitsweise →</a></div><ol class="steps"><li><span>01</span><div><h3>Verstehen</h3><p>Prozesse, Betriebszeiten und Ziele aufnehmen. Die richtigen Fragen stellen.</p></div></li><li><span>02</span><div><h3>Einordnen</h3><p>Technische Optionen vergleichen. Annahmen und Grenzen offenlegen.</p></div></li><li><span>03</span><div><h3>Vorbereiten</h3><p>Maßnahmen priorisieren. Verantwortlichkeiten und nächste Schritte festlegen.</p></div></li></ol></section><section class="section knowledge"><div class="section-heading"><div><p class="eyebrow">FACHWISSEN, DAS WEITERHILFT</p><h2>Ein genauerer Blick.</h2></div><a class="secondary-link" href={href('fachwissen/')}>Alle Beiträge →</a></div><div class="article-grid">{articles.map((a,i)=><a class="article-card" href={href(`fachwissen/${a.slug}/`)}><div class={`article-art art-${i}`} aria-hidden="true"><span>{['↗','≈','↔'][i]}</span><div class="chart-line"></div></div><p class="eyebrow">{a.category} · {a.read}</p><h3>{a.title}</h3><span class="card-link">Beitrag lesen →</span></a>)}</div></section><Cta/></Layout>
